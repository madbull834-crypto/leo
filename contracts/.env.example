# BSC Testnet (chain ID 97). Use a dedicated test-only wallet.
BSC_TESTNET_RPC_URL=https://bsc-testnet-dataseed.bnbchain.org
PRIVATE_KEY=0xYOUR_TEST_WALLET_PRIVATE_KEY

# Optional BscScan contract verification.
BSCSCAN_API_KEY=

# BSC Mainnet (chain ID 56). Do not reuse the testnet deployer.
# Keep the private RPC separate from the public URL embedded in the frontend.
BSC_MAINNET_RPC_URL=https://your-private-bsc-mainnet-rpc.example
BSC_MAINNET_PUBLIC_RPC_URL=https://bsc-dataseed.bnbchain.org
MAINNET_DEPLOYER_PRIVATE_KEY=0xYOUR_DEDICATED_MAINNET_DEPLOYER_KEY
MAINNET_EXPECTED_DEPLOYER_ADDRESS=0x0000000000000000000000000000000000000000

# Existing production ERC-20 accepted by the protocol (never TestUSDT).
MAINNET_PAYMENT_ASSET=0x0000000000000000000000000000000000000000

# Production governance/operations addresses. Multisigs are strongly recommended.
MAINNET_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000
MAINNET_DEFAULT_ADMIN_ADDRESS=0x0000000000000000000000000000000000000000
MAINNET_OPERATOR_ADDRESS=0x0000000000000000000000000000000000000000
MAINNET_REWARD_MANAGER_ADDRESS=0x0000000000000000000000000000000000000000
MAINNET_PAUSER_ADDRESS=0x0000000000000000000000000000000000000000
MAINNET_TREASURY_ROLE_ADDRESS=0x0000000000000000000000000000000000000000
MAINNET_PROXY_ADMIN_OWNER=0x0000000000000000000000000000000000000000

# Required only for the state-changing deployment command.
# MAINNET_DEPLOY_CONFIRMATION=DEPLOY_THE_LIOX_TO_BSC_MAINNET
MAINNET_CONFIRMATIONS=5
